# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Web App URL (must be HTTPS in production — Telegram requires HTTPS for Mini Apps)
WEB_APP_URL=https://your-domain.com

# Server Port
PORT=3000

# ── Webhook vs Polling ────────────────────────────────────────────────────────
# Set WEBHOOK_MODE=true to use Telegram webhook (recommended for production).
# Leave false to use polling (useful for local development).
WEBHOOK_MODE=false

# Secret token for webhook verification (generate a random string, e.g. openssl rand -hex 32).
# Telegram sends this in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_BOT_SECRET=

# ── Telegram initData Validation ─────────────────────────────────────────────
# Set VALIDATE_INIT_DATA=true to enforce HMAC-SHA256 verification of every
# /api/* request (recommended for production). Leave false for local dev.
VALIDATE_INIT_DATA=false

# ── AI API Configuration ──────────────────────────────────────────────────────
# Choose your AI provider and fill in the appropriate key.

# Option 1: OpenAI (recommended)
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI model to use (default: gpt-4o-mini — fast and cost-effective)
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Cloud NLP
# GOOGLE_CLOUD_API_KEY=your_google_api_key_here

# Option 3: HuggingFace
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# AI Provider (openai, google, huggingface, or mock for testing)
AI_PROVIDER=mock
